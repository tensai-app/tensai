<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TEN-186: find_contact and the name lookup of draft_sms / draft_email. Asked at first use, never at launch;
         the contacts are read on the phone and only handed to the local model and the draft intent. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- TEN-179: read_calendar and location. Asked at first use, never at launch. The calendar is read for one range
         (title, time, place) and the location is the coarse one (about 1 km, never FINE): both only go to the local
         model. tensai itself never geocodes; coordinates only leave the phone through Network-tier tools (weather). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Hugging Face model browsing/download only (TEN-136). The network is used to fetch model
         listings and files from huggingface.co and nothing else: no telemetry, no other host.
         "Nothing leaves the device" stays true, see the hf package (HfClient) for the contract. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TEN-177: set_alarm and set_timer. A normal permission (granted at install, no prompt) that lets the
         app hand an alarm or timer to the Clock app. Nothing else is read or written. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- TEN-177: package visibility (Android 11+) for the phone actions. Each entry is the intent a tool
         starts, so tensai sees which app would answer and names it ("Opened in Clock"); the launcher entry
         lists the apps open_app can start. Narrower than QUERY_ALL_PACKAGES, which is not requested. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- TEN-144: backup stays on (default), minus the encrypted Hugging Face token file. Its Keystore
         key is not backed up, so a restored token would be unreadable; it must not travel at all. -->
    <application
        android:name=".TensaiApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="tensai"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Tensai"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <!-- TEN-50: LoadModelViewModel/ChatViewModel are `remember`-ed state holders, not
                 androidx ViewModels, so an Activity recreation loses their in-flight guards and
                 the screen re-triggers a multi-GB load. Handling these configs in place avoids the
                 recreation; InferenceQueue's own dedup covers what this doesn't (process death). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             foregroundServiceType="specialUse": on-device LLM inference doesn't match any
             predefined FGS type (dataSync is for transfer jobs; mediaProcessing targets
             one-shot transcode/export and imposes its own timeout via onTimeout(), neither
             fits a resident model kept in RAM across a long-lived chat). specialUse is
             Android's own documented escape hatch for exactly this "novel use case" situation
             (see PROPERTY_SPECIAL_USE_FGS_SUBTYPE below) and carries no built-in timeout.
        -->
        <service
            android:name=".runtime.InferenceService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device LLM inference" />
        </service>

        <!-- TEN-141: WorkManager runs model downloads in this foreground service when a worker
             calls setForeground. Its own manifest entry has no type; declaring dataSync here
             (merged over the library's) is what lets the worker start it as a data transfer. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Pause / Cancel actions of the download notification. -->
        <receiver
            android:name=".download.DownloadActionReceiver"
            android:exported="false" />
    </application>

</manifest>
