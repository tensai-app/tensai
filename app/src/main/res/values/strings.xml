    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_light_subtitle">Light, always</string>

    <!-- Appearance > language. One entry per io.github.hokanosekai.tensai.data.AppLanguage. -->
    <string name="settings_language">Language</string>
    <string name="settings_language_system">System</string>
    <string name="settings_language_english">English</string>
    <string name="settings_language_french">Français</string>

    <!-- Inference > backend. One entry per io.github.hokanosekai.tensai.data.BackendPreference. -->
    <string name="settings_backend">Default backend</string>
    <string name="settings_backend_auto">Auto</string>
    <string name="settings_backend_auto_subtitle">Recommended — picks CPU or GPU per model</string>
    <string name="settings_backend_cpu">CPU</string>
    <string name="settings_backend_cpu_subtitle">Fastest for most dense models on this class of phone</string>
    <string name="settings_backend_gpu">Vulkan</string>
    <string name="settings_backend_gpu_subtitle">GPU offload, when the device has it</string>

    <!-- Inference > read-only rows. See io.github.hokanosekai.tensai.ui.screens.settings.InferenceFacts. -->
    <string name="settings_context_size">Context size</string>
    <!-- %1$d is a token count. -->
    <string name="settings_context_size_value">%1$d tokens</string>
    <string name="settings_kv_cache">KV cache type</string>
    <!-- %1$s is a cache precision (f16, q8_0…), %2$s who chose it (settings_inference_chosen_auto). -->
    <string name="settings_kv_cache_value">%1$s · %2$s</string>
    <string name="settings_inference_chosen_auto">auto</string>
    <string name="settings_inference_unknown">—</string>
    <!-- %1$s is a model\'s display name. -->
    <string name="settings_inference_in_use">In use by %1$s</string>
    <string name="settings_inference_planned">Planned for %1$s — chosen per load from free memory</string>
    <string name="settings_inference_no_model">No model loaded and none on disk</string>

    <!-- Storage. -->
    <string name="settings_storage_models">Models</string>
    <!-- %1$s is the size the models take, %2$s the size of the volume they sit on. -->
    <string name="settings_storage_models_usage">%1$s of %2$s</string>
    <string name="settings_storage_manage_models">Manage models</string>
    <string name="settings_storage_sessions">Saved sessions</string>
    <!--
         %1$s is a total size, %2$d how many sessions make it up. A plural, not a string: this app
         keeps at most two sessions (see SessionStoragePolicy), so "1 session" is a case the user
         hits constantly, and languages that inflect it differently are not this file's to guess.
    -->
    <plurals name="settings_storage_sessions_usage">
        <item quantity="one">%1$s across %2$d session</item>
        <item quantity="other">%1$s across %2$d sessions</item>
    </plurals>
    <string name="settings_storage_sessions_empty">Nothing saved</string>
    <string name="settings_storage_sessions_explainer">Saved sessions let a conversation resume without re-reading its whole history. Clearing them frees space; the conversations themselves stay.</string>
    <string name="settings_storage_clear">Clear</string>
    <string name="settings_storage_clear_title">Clear saved sessions?</string>
    <string name="settings_storage_clear_body">This deletes every saved conversation state from this device. Your conversations and models are untouched, and a reply being generated right now keeps going — it just has to re-read its history the next time it is reopened.</string>
    <string name="settings_storage_clear_confirm">Clear</string>
    <string name="settings_storage_clear_cancel">Cancel</string>
    <!-- %1$s is the amount of space that came back. -->
    <string name="settings_storage_cleared">Cleared — %1$s freed</string>
    <string name="settings_storage_cleared_nothing">Nothing to clear</string>

    <!-- About. -->
    <string name="settings_version">Version</string>
    <string name="settings_licenses">Open-source licenses</string>
    <!-- %1$s is a license name (MIT, Apache 2.0…), %2$s the copyright holder. -->
    <string name="settings_license_line">%1$s · %2$s</string>

    <!-- ==================== Empty states and errors (TEN-39) ==================== -->

    <!--
         Everything below is what the user reads when something is missing or has gone wrong. One
         rule governs the lot: no string here may contain an exception class name, a stack frame,
         a package name or the raw text of a Throwable. `NoTechnicalJargonTest` enforces it by
         reading this very file, so a jargon-carrying string added here fails the build rather than
         reaching a screen.
    -->

    <!-- Drawer > Recents, before the first conversation exists. -->
    <string name="drawer_recents_empty">No chats yet</string>

    <!-- Compatibility traffic light. One label per io.github.hokanosekai.tensai.compat.Verdict. -->
    <string name="model_compat_runs_well">Runs well</string>
    <string name="model_compat_tight_fit">Tight fit</string>
    <string name="model_compat_wont_fit">Won\'t fit</string>
    <!--
         %1$s is the memory this model needs, %2$s what the phone has — both already formatted as
         sizes. The two numbers come from Compatibility.estimatedBytes/deviceRamBytes and nowhere
         else, so the sentence can never disagree with the dot next to it.
    -->
    <string name="model_compat_explanation">needs ~%1$s, your phone has %2$s</string>
    <!-- Deliberately quiet: it overrides a red light, so it must not read like the obvious action. -->
    <string name="model_compat_load_anyway">Load anyway</string>

    <!-- Models > storage pressure banner. See io.github.hokanosekai.tensai.ui.screens.models.StoragePressure. -->
    <string name="models_storage_low_title">Storage is nearly full</string>
    <!-- %1$s is the free space left, %2$s the average size of the models already on the phone. -->
    <string name="models_storage_low_body">Only %1$s left, and the models here take %2$s each on average.</string>
    <string name="models_storage_free_up">Free up space</string>

    <!-- Models > import failure card. One body per io.github.hokanosekai.tensai.ui.screens.models.ImportFailure. -->
    <string name="import_failed_title">Import didn\'t finish</string>
    <!-- %1$s is the file's name. -->
    <string name="import_failed_already_imported">%1$s is already in your models.</string>
    <!-- %1$s is the size the file needs, %2$s the free space there was. -->
    <string name="import_failed_no_space">This file needs %1$s and there is %2$s free. Remove a model and try again.</string>
    <!-- %1$s is the file's name. -->
    <string name="import_failed_not_a_model">%1$s isn\'t a GGUF model file, or the copy came out damaged.</string>
    <!-- %1$s is the file's name. -->
    <string name="import_failed_copy_interrupted">Copying %1$s stopped before it finished. Nothing was kept.</string>
    <string name="import_failed_unknown">The import stopped before it finished. Nothing was kept.</string>
    <string name="import_failed_retry">Try again</string>
    <string name="import_failed_dismiss">Dismiss</string>

    <!-- Loading > failure dialogs. See io.github.hokanosekai.tensai.ui.screens.loading.LoadFailure. -->
    <string name="load_failed_title">Couldn\'t load this model</string>
    <string name="load_failed_unreadable">This file may be damaged, or it isn\'t a model this app can run. Re-importing only helps if your copy was damaged.</string>
    <string name="load_failed_busy">Something else was still using the model. Give it a moment and try again.</string>
    <string name="load_failed_unknown">Loading stopped before it finished.</string>

    <!-- Chat > a reply that produced nothing at all before breaking. See ChatError.GenerationFailed. -->
