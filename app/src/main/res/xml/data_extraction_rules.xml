<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Only the Hugging Face token file (TEN-144) and the search API keys file (TEN-174) are excluded; everything else keeps the
     default backup behaviour. The token is encrypted with a Keystore key that never leaves the
     device, so a restored copy could not be opened anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/tensai_hf_token.preferences_pb" />
        <exclude domain="file" path="datastore/tensai_hf_token.preferences_pb.tmp" />
        <exclude domain="file" path="datastore/tensai_search_keys.preferences_pb" />
        <exclude domain="file" path="datastore/tensai_search_keys.preferences_pb.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/tensai_hf_token.preferences_pb" />
        <exclude domain="file" path="datastore/tensai_hf_token.preferences_pb.tmp" />
        <exclude domain="file" path="datastore/tensai_search_keys.preferences_pb" />
        <exclude domain="file" path="datastore/tensai_search_keys.preferences_pb.tmp" />
    </device-transfer>
</data-extraction-rules>
