<?xml version="1.0" encoding="utf-8"?>
<!--
     French translation of values/strings.xml (TEN-41). Same keys, same placeholders: StringsParityTest
     fails the build if either drifts.

     Conventions: neutral product UI register, actions in the infinitive, no "vous"/"tu" when a
     neutral phrasing exists. French typography: a non-breaking space ( ) before : ; ? ! and %,
     and inside « ». Technical terms French developers use as-is stay as-is (GGUF, token, prompt,
     backend, CPU, GPU, Vulkan, KV cache).
-->
