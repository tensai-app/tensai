<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only (TEN-222): amber, so tensai dev is never mistaken for the release app. No monochrome
     layer on purpose: with themed icons on, Android would draw both apps from the same mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background_debug" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_debug" />
</adaptive-icon>
